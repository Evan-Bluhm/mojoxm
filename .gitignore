# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Pixi-managed env
.pixi/

# nsys/ncu traces
*.nsys-rep
*.sqlite
*.ncu-rep

# output
output/*

# test dump outputs (produced by test/test_mpi_correctness.sh +
# test/test_mpi_bc_correctness.sh)
test/dumps_np*/
test/dumps_bc_np*/

# Compiled binaries (Mojo build outputs land in the repo root with no
# file extension).  Source files for benches/tests live under
# benchmarks/, test/, examples/ -- the leading `/` anchors each
# pattern to the root, so .mojo source files are not affected.
/bench_*
/bench-*
/*_test
/*_test_p[0-9]
/*_2d_gpu
/advection_gaussian
/euler_vortex
/euler_taylor_green
/euler_sod
/euler_rising_bubble
/maxwell_cavity
/shallow_water_drop
/mhd_alfven
/two_fluid_langmuir
/mpi_hello
/mpi_partition
/mpi_patch_mesh
/mpi_halo_pingpong
/mojoxm
mojo.sif

# build products
build/*.o

# cron-scheduled task state (Claude Code session-local)
.claude/scheduled_tasks.lock
