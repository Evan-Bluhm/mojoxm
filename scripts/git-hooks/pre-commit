#!/usr/bin/env bash
# pre-commit: reject commits whose staged .mojo files don't match
# `mojo format` output.  Wire up with `make install-hooks` (sets
# core.hooksPath to scripts/git-hooks/).
#
# Validates the *staged* content (`git show :path`), not the working
# tree, so partially-staged hunks are checked correctly.  Files are
# never modified -- if any are out of conformance the hook lists them
# and aborts; run `make format` to fix.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Pick a mojo invocation: explicit MOJO override, then PATH, then the
# pixi-managed env that the Makefile defaults to.  Stored as an array
# because the pixi fallback is multi-word ("pixi run mojo").  The pixi
# env's bare binary won't find its stdlib without MODULAR_HOME, so we
# go through `pixi run`.
if [[ -n "${MOJO:-}" ]]; then
    # shellcheck disable=SC2206 -- intentional word-split on user override
    mojo_cmd=($MOJO)
elif command -v mojo >/dev/null 2>&1; then
    mojo_cmd=(mojo)
elif [[ -f pixi.toml || -f pyproject.toml ]] && command -v pixi >/dev/null 2>&1; then
    mojo_cmd=(pixi run mojo)
else
    echo "pre-commit: 'mojo' not on PATH and pixi/pyproject.toml not found." >&2
    echo "            Set MOJO=<path> or run 'pixi install'." >&2
    exit 1
fi

# Staged Mojo files (added/copied/modified/renamed only -- skip deletes).
mapfile -t files < <(
    git diff --cached --name-only --diff-filter=ACMR | grep -E '\.mojo$' || true
)
if [[ ${#files[@]} -eq 0 ]]; then
    exit 0
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

# Stage all files first, then run a single `mojo format` over the
# whole batch -- amortises the JIT-warmup over the staged set.  For
# 1-3 staged files the speedup is minor (one JIT either way), but a
# refactor touching 20+ files goes from N * (single JIT) to one.
copies=()
for f in "${files[@]}"; do
    tmp="$tmpdir/$f"
    mkdir -p "$(dirname "$tmp")"
    git show ":$f" > "$tmp"
    copies+=("$tmp")
done

"${mojo_cmd[@]}" format -l 200 -q "${copies[@]}"

bad=()
for f in "${files[@]}"; do
    if ! git show ":$f" | diff -q - "$tmpdir/$f" >/dev/null 2>&1; then
        bad+=("$f")
    fi
done

if [[ ${#bad[@]} -gt 0 ]]; then
    echo "pre-commit: the following staged Mojo files are not formatted:" >&2
    printf '  %s\n' "${bad[@]}" >&2
    echo >&2
    echo "Run 'make format' (or 'mojo format -l 200 <file>') and re-stage." >&2
    exit 1
fi
